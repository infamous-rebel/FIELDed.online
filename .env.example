# FIELDed Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=FIELDed
APP_VERSION=0.1.0
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://fielded:fielded@localhost:5432/fielded
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (optional — adapter pattern, not required for core operation)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (adapter pattern — provider-agnostic)
# Supported: mock (stub), openai (OpenAI-compatible API including Groq)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Optional: override API base URL for OpenAI-compatible providers (e.g. Groq)
# AI_BASE_URL=https://api.groq.com/openai/v1/

# Per-workload AI overrides (empty → fall back to global AI_* above)
# Each workload can use its own API key and base URL (e.g. separate Groq keys).
# When a workload-specific field is empty, the global AI_API_KEY / AI_BASE_URL is used.
# DISCOVERY_AI_API_KEY=
# DISCOVERY_AI_BASE_URL=https://api.groq.com/openai/v1/
# CALL_AGENT_AI_API_KEY=
# CALL_AGENT_AI_BASE_URL=https://api.groq.com/openai/v1/
# BRAIN_AI_API_KEY=
# BRAIN_AI_BASE_URL=https://api.groq.com/openai/v1/

# Email Provider (adapter pattern)
# Supported: mock, resend
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@fielded.local
# Resend webhook signing secret (configured in Resend dashboard → Webhooks)
# Used to verify inbound delivery webhooks at /api/v1/webhooks/communications/resend
# RESEND_WEBHOOK_SECRET=whsec_...

# Storage Provider (adapter pattern)
STORAGE_PROVIDER=local
STORAGE_BUCKET=fielded-uploads
STORAGE_BASE_PATH=./uploads

# SMS Provider (adapter pattern)
# Supported: mock, twilio, vonage
SMS_PROVIDER=mock
SMS_API_KEY=

# Voice / Call Agent
# Supported: mock, twilio, vonage
VOICE_PROVIDER=mock

# Twilio (shared across SMS + Voice when selected)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vonage (SMS, WhatsApp, Voice — when selected)
# Obtain from Vonage Dashboard → Settings → API Settings
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# Application-based auth (Messages API, Voice API):
VONAGE_APPLICATION_ID=
VONAGE_APPLICATION_PRIVATE_KEY=
VONAGE_NUMBER=
# Vonage WhatsApp number (if different from VONAGE_NUMBER)
# VONAGE_WHATSAPP_NUMBER=
# Vonage webhook signing secret (Dashboard → Settings → Signing Secret)
# Used to verify inbound message status webhooks at /api/v1/webhooks/communications/vonage_*
# VONAGE_WEBHOOK_SECRET=

# Public HTTPS base URL for provider webhooks (Twilio, Vonage, etc.)
# Development: ngrok/tunnel URL (e.g. https://abc123.ngrok.io)
# Production: real HTTPS domain (e.g. https://api.fielded.online)
PUBLIC_BASE_URL=

# Payment Provider
# Supported: mock (stub), stripe
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Stripe (set PAYMENT_PROVIDER=stripe to activate)
# Test mode key starts with sk_test_ — no real charges
# Live mode key starts with sk_live_ — real charges processed
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend publishable key (public, safe to expose in browser)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# WhatsApp Provider (adapter pattern)
# Supported: mock (stub), whatsapp_cloud (Meta), vonage_whatsapp (Vonage Messages API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Push Notification Provider (adapter pattern)
# Supported: mock (stub), firebase (Firebase Cloud Messaging)
PUSH_PROVIDER=mock
PUSH_API_KEY=
FIREBASE_PROJECT_ID=

# Calendar Provider (adapter pattern)
# Supported: mock (stub), google (Google Calendar API)
CALENDAR_PROVIDER=mock
CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=primary

# Google Calendar OAuth (per-business "Connect Google Calendar" flow)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match exactly (e.g. https://api.fielded.online/api/v1/calendar/oauth/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# OAuth token encryption key (Fernet-compatible, 32 url-safe base64 bytes)
# If empty, tokens are encrypted using a key derived from APP_SECRET_KEY.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Accounting Provider (adapter pattern)
# Supported: mock (stub)
ACCOUNTING_PROVIDER=mock
ACCOUNTING_API_KEY=

# CRM Provider (adapter pattern)
# Supported: mock (stub)
CRM_PROVIDER=mock
CRM_API_KEY=

# Cloudflare (frontend deployment)
# These are CI/CD secrets — set in GitHub Actions secrets, NOT runtime env.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Distributed Rate Limiting
# Supported: memory (single-instance), redis (multi-instance)
RATE_LIMIT_BACKEND=memory

# Outbox worker
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=300

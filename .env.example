# FIELDed Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=FIELDed
APP_VERSION=0.1.0
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://fielded:fielded@localhost:5432/fielded
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (adapter pattern — replace with any provider)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Email Provider (adapter pattern)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@fielded.local

# Storage Provider (adapter pattern)
STORAGE_PROVIDER=local
STORAGE_BUCKET=fielded-uploads
STORAGE_BASE_PATH=./uploads

# SMS Provider (adapter pattern)
SMS_PROVIDER=mock
SMS_API_KEY=

# Calendar Provider (adapter pattern)
CALENDAR_PROVIDER=mock
CALENDAR_API_KEY=

# Voice / Twilio (Phase 14C)
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS base URL for Twilio webhooks (Phase 14C)
# Development: ngrok/tunnel URL (e.g. https://abc123.ngrok.io)
# Production: real HTTPS domain (e.g. https://api.fielded.com)
PUBLIC_BASE_URL=

# AI Provider for Call Agent conversations (Phase 14C)
# Supported: mock (stub), openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Payment Provider (Phase 15)
# Supported: mock (stub), stripe
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Stripe (Phase 15 — set PAYMENT_PROVIDER=stripe to activate)
# Test mode key starts with sk_test_ — no real charges
# Live mode key starts with sk_live_ — real charges processed
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
